    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = {};\n\nfor (const item of items) {\n  const ct = item.json.contentType;\n  const c = item.json.content;\n  if (ct === 'quiz' || ct === 'flashcards') {\n    try {\n      // Strip markdown code blocks if present\n      const cleaned = typeof c === 'string' ? c.replace(/```json\\n?|```\\n?/g, '').trim() : c;\n      result[ct] = typeof cleaned === 'string' ? JSON.parse(cleaned) : cleaned;\n    } catch (e) {\n      result[ct] = c;\n    }\n  } else {\n    result[ct] = c;\n  }\n}\n\nreturn [{ json: result }];"
      },
      "id": "74de7e41-64e6-4093-b97d-3718db919fa0",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
